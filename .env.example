APP_PORT=3000
APP_LEVEL=debug

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-for-deployment
DB_NAME=microservice_db
DB_SSLMODE=disable
# Path inside the service to a persistent RSA signing key (PKCS#1 or PKCS#8 PEM).
AUTH_SIGNING_KEY_FILE=
# Comma-separated exact HTTPS hosts serving skin images.
AUTH_SKIN_DOMAINS=
# Random secret shared exclusively with the server provisioning service.
AUTH_PROVISION_TOKEN=
# IP addresses or CIDRs allowed to set X-Real-IP. Empty means direct connections.
AUTH_TRUSTED_PROXIES=
